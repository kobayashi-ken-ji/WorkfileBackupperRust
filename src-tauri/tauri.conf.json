{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workfile Buckupper",
  "version": "0.1.0",
  "identifier": "com.conaca.workfile-backupper",
  "build": {
    "beforeDevCommand": "esbuild src/main.ts --bundle --format=esm --outfile=src/main.js --watch",
    "beforeBuildCommand": "esbuild src/main.ts --bundle --format=esm --outfile=src/main.js",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Workfile Buckupper",
        "width": 600,
        "height": 950,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Kobayashi Kenji",
    "windows": {
      "wix": {
        "language": ["ja-JP"]
      }
    }
  }
}
